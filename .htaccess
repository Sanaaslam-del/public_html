RewriteEngine On

# ---------------------------------------------------
# STEP 1: Force HTTPS + non-www (Canonical Domain)
# ---------------------------------------------------
# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://vartexsoft.com%{REQUEST_URI} [R=301,L]

# Force non-www
RewriteCond %{HTTP_HOST} ^www\.vartexsoft\.com$ [NC]
RewriteRule ^ https://vartexsoft.com%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------
# STEP 1B: Remove trailing slash from clean URLs
# (Avoids duplicate content issues in SEO)
# ---------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# ---------------------------------------------------
# STEP 2: Redirect OLD .html / /src/ URLs to CLEAN URLs
# (Uses THE_REQUEST to prevent internal redirect loops)
# ---------------------------------------------------
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect legacy root-level HTML URLs to their clean URLs.
RewriteRule ^services\.html$ /services [R=301,L,NC]
RewriteRule ^courses\.html$ /courses [R=301,L,NC]
RewriteRule ^dubai-services\.html$ /dubai-services [R=301,L,NC]
RewriteRule ^blog\.html$ /blog [R=301,L,NC]
RewriteRule ^aboutUs\.html$ /about [R=301,L,NC]
RewriteRule ^contactUs\.html$ /contact [R=301,L,NC]
RewriteRule ^applyForAdmission\.html$ /apply-for-admission [R=301,L,NC]
RewriteRule ^applyForProject\.html$ /apply-for-project [R=301,L,NC]
RewriteRule ^applyForInternship\.html$ /apply-for-internship [R=301,L,NC]
